{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpt-public-ai-weekly-report",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    {
      "binding": "QUESTION_LOG",
      "id": "bccfe0323be440109a260ba057de3b9e"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "triggers": {
    "crons": ["0 16 * * 1"]
  }
}
