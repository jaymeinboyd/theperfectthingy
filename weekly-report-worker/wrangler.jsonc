{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tpt-public-ai-weekly-report",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["0 16 * * 1"]
  }
}
